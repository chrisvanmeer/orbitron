---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	image?: string;
	bare?: boolean;
	noindex?: boolean;
}

const site = Astro.site?.href ?? 'https://getorbitron.app';
const {
	title = 'Orbitron — Ansible Galaxy & Git Mirror Daemon',
	description = 'A custom, lightweight Ansible Galaxy and Git-based role/collection mirror daemon written in Go. Self-hosted, air-gap ready, drop-in for ansible-galaxy.',
	image = 'https://getorbitron.app/og.png',
	bare = false,
	noindex = false,
} = Astro.props;

const isError = Astro.url.pathname.endsWith('/404') || Astro.url.pathname.endsWith('/404/');
const canonical = isError ? site : new URL(Astro.url.pathname, site).href;
const absoluteImage = image.startsWith('http') ? image : new URL(image, site).href;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{noindex && <meta name="robots" content="noindex,nofollow" />}

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#050505" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Orbitron" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={absoluteImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:url" content={canonical} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={absoluteImage} />

		{!isError && (
			<script type="application/ld+json" set:html={JSON.stringify({
				'@context': 'https://schema.org',
				'@graph': [
					{
						'@type': 'SoftwareApplication',
						name: 'Orbitron',
						applicationCategory: 'DeveloperApplication',
						operatingSystem: 'Linux, macOS, FreeBSD',
						description,
						url: 'https://getorbitron.app',
						author: { '@type': 'Person', name: 'Chris van Meer' },
						license: 'https://www.gnu.org/licenses/gpl-3.0.html',
						offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
						features: [
							'Ansible Galaxy V1 + V3 mirror API',
							'Git-backed role mirroring',
							'Access-based retention and pruning',
							'Web dashboard with SSO/OIDC',
							'Prometheus metrics',
						],
					},
					{
						'@type': 'WebSite',
						name: 'Orbitron',
						url: 'https://getorbitron.app',
						publisher: { '@type': 'Person', name: 'Chris van Meer' },
						funder: { '@type': 'Organization', name: 'AT Computing' },
					},
				],
			})} />
		)}
	</head>
	<body class:list={bare && 'bare'}>
		{!bare && <Navbar />}
		<main>
			<slot />
		</main>
		{!bare && <Footer />}
	</body>
</html>