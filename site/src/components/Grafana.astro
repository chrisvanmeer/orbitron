---
import { Image } from 'astro:assets';
import grafanaPng from '../assets/grafana.png';

const highlights = [
	{
		t: 'Multi-daemon',
		d: 'A single dashboard follows every Orbitron instance behind the same Prometheus via the Orbitron instance template variable.',
	},
	{
		t: 'Storage & versions',
		d: 'Disk usage, role/collection counts and blocked storage bytes over time — per item and per cached version.',
	},
	{
		t: 'Overview stats',
		d: 'Uptime, namespaces, tokens and more in stat panels — two visual variants ship in the repo.',
	},
	{
		t: 'Heavy hitters',
		d: 'A ranked table of the largest cached versions by on-disk footprint — the items that actually drive your capacity plan, at a glance.',
	},
];
---

<section class="section grafa" id="grafana">
	<div class="wrap">
		<div class="section-head">
			<span class="eyebrow">Observability</span>
			<h2>Ship a mirror, not dashboards</h2>
			<p>
				A ready-made Grafana dashboard accompanies the Prometheus endpoint — import it and point it
				at the scrape targets. Both variants (<code>orbitron_v13_current.json</code> and
				<code>orbitron_v12_legacy.json</code>) bind to the data source you pick on import.
			</p>
		</div>

		<div class="grafa-grid">
			<div class="browser">
				<div class="browser-bar">
					<span class="dots"><span></span><span></span><span></span></span>
					<span class="addr">grafana // orbitron overview</span>
					<span class="zoom-hint">↗ click for full size</span>
				</div>
				<a class="grafa-img-open" href={grafanaPng.src} title="Open the Grafana dashboard screenshot at full size">
					<Image
						src={grafanaPng}
						alt="Orbitron Grafana dashboard screenshot"
						width={3024}
						height={1898}
						widths={[640, 1024, 1600, 3024]}
						sizes="(min-width: 900px) min(100%, 94rem), 100vw"
						loading="lazy"
					/>
				</a>
			</div>

			<div class="grafa-lightbox" role="dialog" aria-modal="true" aria-label="Grafana dashboard screenshot, zoomed in">
				<img data-full src={grafanaPng.src} alt="Orbitron Grafana dashboard screenshot, full size" />
			</div>

			<ul class="grafa-list">
				{
					highlights.map((h, i) => (
						<li class="grafa-item">
							<span class="grafa-num">0{i + 1}</span>
							<div class="grafa-body">
								<h3>{h.t}</h3>
								<p>{h.d}</p>
							</div>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>

<script>
	document.querySelectorAll('.grafa-img-open').forEach((a) => {
		a.addEventListener('click', (e) => {
			e.preventDefault();
			const lb = document.querySelector('.grafa-lightbox');
			if (!lb) {
				window.open(a.href, '_blank', 'noopener');
				return;
			}
			lb.classList.add('open');
		});
	});
	document.querySelectorAll('.grafa-lightbox').forEach((lb) => {
		lb.addEventListener('click', () => lb.classList.remove('open'));
		lb.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') lb.classList.remove('open');
		});
	});
</script>

<style>
	.grafa {
		background: linear-gradient(180deg, transparent, rgba(13, 14, 22, 0.5) 20%, rgba(13, 14, 22, 0.5) 80%, transparent);
	}

	.grafa-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.7rem;
		align-items: start;
	}

	.browser {
		border: 1px solid var(--border);
		border-radius: var(--radius);
		overflow: hidden;
		background: var(--bg-deep);
		box-shadow: 0 40px 90px -40px rgba(0, 0, 0, 0.9), 0 0 0 1px rgba(255, 0, 122, 0.06);
	}

	.browser-bar {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		padding: 0.65rem 0.9rem;
		border-bottom: 1px solid var(--border);
		background: rgba(5, 5, 5, 0.6);
	}

	.dots {
		display: inline-flex;
		gap: 0.35rem;
	}
	.dots span {
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: #2a3038;
	}
	.dots span:nth-child(1) { background: var(--red); }
	.dots span:nth-child(2) { background: var(--yellow); }
	.dots span:nth-child(3) { background: var(--cyan); }

	.addr {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--text-dim);
		background: rgba(139, 148, 158, 0.08);
		border: 1px solid var(--border);
		border-radius: 6px;
		padding: 0.2rem 0.7rem;
		margin-inline: auto;
	}

	.zoom-hint {
		font-family: var(--font-mono);
		font-size: 0.62rem;
		color: rgba(0, 240, 255, 0.75);
		letter-spacing: 0.06em;
	}

	.grafa-img-open {
		display: block;
		cursor: zoom-in;
		outline: none;
	}
	.grafa-img-open:focus-visible img {
		box-shadow: 0 0 0 2px var(--pink);
	}

	.browser img {
		width: 100%;
		height: auto;
	}

	.grafa-lightbox {
		position: fixed;
		inset: 0;
		z-index: 200;
		display: none;
		align-items: center;
		justify-content: center;
		padding: 2.2rem;
		background: rgba(2, 4, 10, 0.92);
		cursor: zoom-out;
	}
	.grafa-lightbox.open { display: flex; }
	.grafa-lightbox img {
		max-width: 100%;
		max-height: 100%;
		width: auto;
		height: auto;
		border-radius: var(--radius);
		box-shadow: 0 30px 90px -20px rgba(0, 0, 0, 0.95), 0 0 0 1px rgba(255, 0, 122, 0.2);
	}

	.grafa-list {
		list-style: none;
		margin: 1.75rem 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1rem;
	}

	.grafa-item {
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
		align-items: flex-start;
		padding: 1.2rem 1.2rem;
		background: linear-gradient(180deg, var(--bg-card) 0%, var(--bg-panel) 100%);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		position: relative;
		overflow: hidden;
		transition: transform 0.2s ease, border-color 0.2s ease;
	}

	.grafa-item:hover {
		transform: translateY(-3px);
		border-color: var(--border-strong);
	}

	.grafa-item::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0;
		bottom: 0;
		width: 2px;
		background: linear-gradient(180deg, var(--cyan), var(--pink));
		opacity: 0.7;
	}

	.grafa-num {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 700;
		color: var(--cyan);
		background: rgba(0, 240, 255, 0.08);
		border: 1px solid rgba(0, 240, 255, 0.25);
		border-radius: 8px;
		padding: 0.2rem 0.45rem;
		white-space: nowrap;
	}

	.grafa-body {
		min-width: 0;
	}

	.grafa-body h3 {
		font-size: 0.98rem;
		margin-bottom: 0.35rem;
		color: var(--cyan);
		font-family: var(--font-mono);
		font-weight: 600;
		letter-spacing: 0.02em;
	}

	.grafa-body p {
		font-size: 0.87rem;
		color: var(--text-dim);
	}

	@media (max-width: 960px) {
		.grafa-list {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 560px) {
		.grafa-list {
			grid-template-columns: 1fr;
		}
	}
</style>