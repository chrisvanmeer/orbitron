---
import CodeBlock from './CodeBlock.astro';

const stats = [
	{ value: '1', label: 'static binary' },
	{ value: '0', label: 'runtime deps' },
	{ value: 'V1+V3', label: 'Galaxy APIs' },
	{ value: '90d', label: 'default prune' },
];
---

<section class="hero" id="top">
	<div class="orbits" aria-hidden="true">
		<div class="ring ring-a"></div>
		<div class="ring ring-b"></div>
		<div class="ring ring-c"></div>
	</div>

	<div class="wrap">
		<p class="eyebrow">Ansible Galaxy &amp; Git Mirror Daemon</p>

		<h1 class="wordmark">ORBITRON</h1>

		<p class="tagline">
			Self-hosted mirror for Ansible roles &amp; collections. A single static Go binary that speaks
			native Galaxy V1 + V3 APIs — so <code>ansible-galaxy</code> just works against it, with zero
			client changes, even when there is no internet.
		</p>

		<div class="cta-row">
			<a class="btn btn-primary" href="#quickstart">Get Started</a>
			<a class="btn btn-ghost" href="https://github.com/chrisvanmeer/orbitron" target="_blank" rel="noopener">
				<svg viewBox="0 0 16 16" width="15" height="15" fill="currentColor" aria-hidden="true">
					<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
				</svg>
				GitHub
			</a>
			<a class="btn badge" href="https://github.com/chrisvanmeer/orbitron/stargazers" target="_blank" rel="noopener">
				<span class="badge-star">★</span>
				<span class="badge-text">Star on GitHub</span>
			</a>
		</div>

		<div class="hero-code card">
			<CodeBlock
				filename="ansible.cfg"
				label="CLIENT — no changes needed"
				lang="ini"
			>{`[galaxy]
server_list = orbitron

[galaxy_server.orbitron]
url = https://orbitron.internal/api/`}</CodeBlock>
		</div>

		<ul class="stats">
			{
				stats.map((s) => (
					<li>
						<span class="stat-value">{s.value}</span>
						<span class="stat-label">{s.label}</span>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.hero {
		position: relative;
		overflow: hidden;
		padding-block: clamp(64px, 9vw, 120px) clamp(48px, 7vw, 96px);
		text-align: center;
	}

	.eyebrow {
		justify-content: center;
	}

	.eyebrow::before,
	.eyebrow::after {
		content: '';
		width: 22px;
		height: 1px;
		background: linear-gradient(90deg, var(--cyan), transparent);
	}
	.eyebrow::after {
		background: linear-gradient(-90deg, var(--pink), transparent);
	}

	.wordmark {
		font-size: clamp(3.4rem, 13vw, 8rem);
		font-weight: 900;
		letter-spacing: clamp(0.06em, 0.5vw, 0.14em);
		line-height: 1;
		margin-top: 1.2rem;
		background: linear-gradient(105deg, #fff 25%, var(--cyan) 50%, var(--indigo) 75%, #fff);
		background-size: 220% 100%;
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
		animation: shimmer 9s ease-in-out infinite;
		filter: drop-shadow(0 18px 60px rgba(0, 240, 255, 0.16));
	}

	@keyframes shimmer {
		0%, 100% { background-position: 0% 50%; }
		50% { background-position: 100% 50%; }
	}

	.tagline {
		max-width: 680px;
		margin: 1.6rem auto 0;
		color: var(--text-mid);
		font-size: clamp(1rem, 2vw, 1.18rem);
	}

	.tagline code {
		font-family: var(--font-mono);
		color: var(--cyan);
		background: rgba(0, 240, 255, 0.08);
		padding: 0.1rem 0.35rem;
		border-radius: 6px;
	}

	.cta-row {
		display: flex;
		justify-content: center;
		gap: 1rem;
		margin-top: 2.2rem;
		flex-wrap: wrap;
	}

	.badge {
		border-color: rgba(252, 238, 10, 0.45);
		background: rgba(252, 238, 10, 0.06);
		color: var(--text);
	}

	.badge:hover {
		border-color: var(--yellow);
		box-shadow: 0 0 20px -6px rgba(252, 238, 10, 0.7);
		transform: translateY(-2px);
	}

	.badge-star {
		color: var(--yellow);
	}

	.badge-text {
		color: var(--text-mid);
		font-weight: 500;
	}

	.hero-code {
		max-width: 620px;
		margin: 3rem auto 0;
		text-align: left;
		box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.8);
	}

	.stats {
		list-style: none;
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1rem;
		max-width: 760px;
		margin: 3.2rem auto 0;
		padding: 0;
	}

	.stats li {
		padding: 1.1rem 0.6rem;
		border-top: 1px solid var(--border);
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
	}

	.stat-value {
		font-family: var(--font-mono);
		font-size: 1.7rem;
		font-weight: 700;
		background: linear-gradient(90deg, var(--cyan), var(--pink));
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.stat-label {
		color: var(--text-dim);
		font-size: 0.78rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}

	@media (max-width: 560px) {
		.stats {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	/* Orbital ring decoration */
	.orbits {
		position: absolute;
		inset: -120px -20% auto;
		height: 420px;
		display: flex;
		justify-content: center;
		pointer-events: none;
	}

	.ring {
		position: absolute;
		top: 0;
		width: min(760px, 90vw);
		aspect-ratio: 2.4;
		border-radius: 50%;
		opacity: 0.5;
	}

	.ring-a {
		border: 1px dashed rgba(0, 240, 255, 0.35);
		transform: rotate(-14deg);
		animation: drift 26s linear infinite;
	}

	.ring-b {
		border: 1px dashed rgba(255, 0, 122, 0.3);
		transform: rotate(8deg);
		animation: drift 22s linear infinite reverse;
	}

	.ring-c {
		border: 1px solid rgba(165, 180, 252, 0.22);
		transform: rotate(2deg);
	}

	@keyframes drift {
		to { transform: rotate(346deg); }
	}
</style>