---
import CodeBlock from './CodeBlock.astro';

const paths = [
	{
		id: 'bare',
		label: 'Bare metal',
		title: 'Install as a systemd service',
		desc: 'Fetch a static binary from the releases page, then --install bootstraps the orbitron user, directories, systemd unit and logrotate in one shot. systemctl reload = hot SIGHUP re-config.',
		file: 'terminal',
		language: 'bash',
		code: `$ sudo ./bin/orbitron --install
$ sudo systemctl status orbitron

# create an admin token (script-friendly: -q)
$ sudo orbitron --generate-token -q

# hot-reload config.yml, no downtime
$ sudo systemctl reload orbitron`,
	},
	{
		id: 'docker',
		label: 'Docker / Compose',
		title: 'Run the GHCR image',
		desc: 'Multi-arch image (amd64 + arm64), non-root, git and openssh-client bundled. Config is rendered from ORBITRON_* env vars — no file to mount. Persist your cache on a volume. Clone the repo first: the docker-compose.yml in the repo root wires up the image, ports, env and the named cache volume.',
		file: 'terminal',
		language: 'bash',
		code: `$ git clone https://github.com/chrisvanmeer/orbitron.git
$ cd orbitron
$ docker compose up -d
# uses docker-compose.yml from the repo root
[+] Running 1/1
 ✔ Container orbitron  Started

$ docker compose logs orbitron | grep "ADMIN TOKEN"
orbitron  | [2026-09-23 08:12:04] ADMIN TOKEN: obt_xxxx...
# also available via ghcr.io/chrisvanmeer/orbitron:latest`,
	},
	{
		id: 'nomad',
		label: 'HashiCorp Nomad',
		title: 'Run the bundled jobspec',
		desc: 'orbitron.nomad.hcl ships in the repo root (service + /healthz check, persistent host volume, secrets via env). Clone the repo and run the jobspec from the clone; register a scratch host volume on the Nomad client before the first run.',
		file: 'terminal',
		language: 'bash',
		code: `$ git clone https://github.com/chrisvanmeer/orbitron.git
$ cd orbitron
$ nomad run orbitron.nomad.hcl
$ nomad status orbitron

$ nomad alloc logs <alloc-id> | grep "ADMIN TOKEN"
# host volume: see the "HashiCorp Nomad" README section`,
	},
	{
		id: 'helm',
		label: 'Kubernetes / Helm',
		title: 'Deploy with the bundled Helm chart',
		desc: 'A StatefulSet with a persistent volume for the cache and admin token, /healthz probes and an optional ingress. Clone the repo first: helm/orbitron in the repo root is a ready-made chart — configure it straight or via your own values.yaml.',
		file: 'terminal',
		language: 'bash',
		code: `$ git clone https://github.com/chrisvanmeer/orbitron.git
$ cd orbitron
$ helm install orbitron ./helm/orbitron

$ kubectl logs orbitron-0 | grep "ADMIN TOKEN"
orbitron-0  | [2026-09-25 09:12:04] ADMIN TOKEN: obt_xxxx...

# behind a reverse proxy:
$ helm install orbitron ./helm/orbitron \\
  --set ingress.enabled=true \\
  --set ingress.hosts[0].host=mirror.internal`,
	},
	{
		id: 'ansible',
		label: 'Ansible collection',
		title: 'Declarative, with the official collection',
		desc: 'chrisvanmeer.orbitron covers the full lifecycle from Ansible: install, configure, bootstrap tokens, mirror wait-for-sync and day-two pruning — six HTTP modules plus two roles.',
		link: '/docs/ansible',
		file: 'orbitron_daemon.yml',
		language: 'bash',
		code: `$ ansible-galaxy collection install chrisvanmeer.orbitron
$ ansible-playbook -i hosts orbitron_daemon.yml

# roles:
#   chrisvanmeer.orbitron.orbitron        # install + operate daemon
#   chrisvanmeer.orbitron.orbitron_mirror # declare roles/collections`,
	},
];
---

<section class="section" id="quickstart">
	<div class="wrap">
		<div class="section-head">
			<span class="eyebrow">Quickstart</span>
			<h2>Up and mirroring in minutes</h2>
			<p>
				Five ways to run a mirror — bare metal, container, Nomad, Kubernetes, or fully managed by
				Ansible. Same superpower underneath: a Galaxy endpoint your playbooks already know how to
				talk to.
			</p>
		</div>

		<div class="qs-card card" data-quickstart>
			<div class="tabs" role="tablist" aria-label="Installation paths">
				{
					paths.map((p, i) => (
						<button
							class:list={['tab', { active: i === 0 }]}
							role="tab"
							aria-selected={i === 0 ? 'true' : 'false'}
							data-path={p.id}
						>
							{p.label}
						</button>
					))
				}
			</div>

			{
				paths.map((p, i) => (
					<div class:list={['path', { active: i === 0 }]} data-panel={p.id}>
						<h3 class="path-title">{p.title}</h3>
						<p class="path-desc">
							{p.desc}
							{p.link && (
								<a class="path-link" href={p.link}>
									Ansible collection docs →
								</a>
							)}
						</p>
						<CodeBlock label="DEPLOY" filename={p.file} lang={p.language}>{p.code}</CodeBlock>
					</div>
				))
			}
		</div>

		<div class="flow-grid">
			<div>
				<h3 class="flow-title">1 · Feed it</h3>
				<p class="flow-sub">Post a YAML requirements manifest — roles, collections or git-backed sources.</p>
				<CodeBlock label="INGEST" filename="roles_requirements.yml" lang="yaml">{`roles:
  - name: geerlingguy.nginx
    version: ">=2.0.0"
  - name: RHEL9-CIS
    src: https://github.com/ansible-lockdown/RHEL9-CIS.git
    version: 2.0.2`}</CodeBlock>
				<CodeBlock label="API" filename="curl" lang="bash">{`curl -X POST https://orbitron.internal/api/v1/requirements/roles \\
  -H "Authorization: Bearer $ORBITRON_TOKEN" \\
  -H "Content-Type: text/yaml" \\
  --data-binary @roles_requirements.yml`}</CodeBlock>
			</div>

			<div>
				<h3 class="flow-title">2 · Consume it</h3>
				<p class="flow-sub">Point ansible-galaxy at the mirror. That is the whole setup.</p>
				<CodeBlock label="CLIENT" filename="ansible.cfg" lang="ini">{`[galaxy]
server_list = orbitron

[galaxy_server.orbitron]
url = https://orbitron.internal/api/
# token = YOUR_ORBITRON_TOKEN  # if require_auth_pull`}</CodeBlock>
				<CodeBlock label="FETCH" filename="terminal" lang="bash">{`# install the roles
ansible-galaxy role install -r roles_requirements.yml
# install the collections
ansible-galaxy collection install -r collections_requirements.yml`}</CodeBlock>
			</div>
		</div>

		<div class="note">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z" />
				<path d="M12 9v4" />
				<path d="M12 17h.01" />
			</svg>
			<p>
				<strong>Put it behind a reverse proxy.</strong> Terminate TLS with <span>Nginx</span>,
				<span>Traefik</span> or <span>HAProxy</span> in front of the daemon — Orbitron honors
				<code>X-Forwarded-Proto</code> / <code>X-Forwarded-For</code>, and <code>ansible.cfg</code>
				above talks native HTTPS. Point load balancer health checks at the unauthenticated
				<code>GET /healthz</code> (<code>200</code> when storage is writable). This keeps API calls,
				tokens and any git credentials in mirrored <code>src</code> URLs encrypted in transit.
			</p>
		</div>
	</div>
</section>

<script>
	const root = document.querySelector('[data-quickstart]');
	const tabs = root.querySelectorAll('[role="tab"]');
	const panels = root.querySelectorAll('[data-panel]');

	tabs.forEach((tab) => {
		tab.addEventListener('click', () => {
			tabs.forEach((t) => {
				t.classList.toggle('active', t === tab);
				t.setAttribute('aria-selected', t === tab ? 'true' : 'false');
			});
			panels.forEach((p) => p.classList.toggle('active', p.dataset.panel === tab.dataset.path));
		});
	});

	const flowGrid = document.querySelector('.flow-grid');
	const equalizeByRow = () => {
		if (!flowGrid) return;
		const cols = [...flowGrid.querySelectorAll<HTMLElement>(':scope > div')];
		const cardCols = cols.map((c) => [...c.querySelectorAll<HTMLElement>('.codeblock')]);
		const maxCols = Math.max(0, ...cardCols.map((c) => c.length));
		for (let i = 0; i < maxCols; i++) {
			const row = cardCols.map((c) => c[i]).filter(Boolean);
			if (row.length < 2) continue;
			let max = 0;
			row.forEach((c) => {
				c.style.height = 'auto';
				max = Math.max(max, c.offsetHeight);
			});
			row.forEach((c) => {
				c.style.height = `${max}px`;
			});
		}
	};
	if (flowGrid) {
		equalizeByRow();
		window.addEventListener('resize', equalizeByRow);
	}
</script>

<style>
	.qs-card {
		padding: 1rem;
	}

	.qs-card.card::before {
		opacity: 1;
	}

	.tabs {
		display: flex;
		gap: 0.4rem;
		flex-wrap: wrap;
		padding: 0.35rem;
		background: rgba(5, 5, 5, 0.5);
		border: 1px solid var(--border);
		border-radius: 12px;
		margin-bottom: 1.6rem;
		width: fit-content;
	}

	.tab {
		appearance: none;
		background: transparent;
		border: none;
		border-radius: 8px;
		padding: 0.55rem 1.1rem;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.05em;
		color: var(--text-dim);
		cursor: pointer;
		transition: color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
	}

	.tab:hover {
		color: var(--text);
	}

	.tab.active {
		color: var(--bg-deep);
		background: linear-gradient(90deg, var(--cyan), var(--violet));
		box-shadow: 0 0 22px -6px rgba(0, 240, 255, 0.7);
	}

	.path {
		display: none;
		padding: 0.2rem 0.4rem 0.4rem;
	}

	.path.active {
		display: block;
	}

	.path-title {
		font-size: 1.25rem;
		margin-bottom: 0.4rem;
	}

	.path-desc {
		color: var(--text-dim);
		font-size: 0.92rem;
		max-width: 60ch;
		margin-bottom: 1.4rem;
	}

	.path-link {
		display: block;
		margin-top: 0.6rem;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		color: var(--cyan);
		border-bottom: 1px solid rgba(0, 240, 255, 0.35);
		width: fit-content;
		transition: color 0.2s ease, border-color 0.2s ease;
	}

	.path-link:hover {
		color: var(--pink);
		border-color: var(--pink);
	}

	.flow-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.2rem;
		margin-top: 2.2rem;
	}

	.flow-grid > div {
		min-width: 0;
	}

	.note {
		display: flex;
		gap: 0.9rem;
		align-items: flex-start;
		margin-top: 1.6rem;
		padding: 1.1rem 1.3rem;
		background: linear-gradient(180deg, rgba(87, 115, 255, 0.08), rgba(13, 14, 22, 0.5));
		border: 1px solid rgba(87, 115, 255, 0.3);
		border-radius: var(--radius);
	}

	.note svg {
		width: 20px;
		height: 20px;
		flex: none;
		color: var(--yellow);
		margin-top: 0.15rem;
	}

	.note p {
		font-size: 0.88rem;
		color: var(--text-mid);
	}

	.note strong {
		color: var(--text);
	}

	.note span {
		font-family: var(--font-mono);
		color: var(--indigo);
	}

	.note code {
		font-family: var(--font-mono);
		color: var(--cyan);
		background: rgba(0, 240, 255, 0.07);
		padding: 0.05rem 0.3rem;
		border-radius: 5px;
		font-size: 0.9em;
	}

	.flow-title {
		font-size: 1.05rem;
		margin-bottom: 0.35rem;
		font-family: var(--font-mono);
		font-weight: 600;
		letter-spacing: 0.02em;
		color: var(--cyan);
	}

	.flow-sub {
		color: var(--text-dim);
		font-size: 0.9rem;
		margin-bottom: 1.2rem;
	}

	.flow-grid :global(.codeblock + .codeblock) {
		margin-top: 1rem;
	}

	@media (max-width: 900px) {
		.flow-grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>