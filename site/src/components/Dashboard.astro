---
import { Image } from 'astro:assets';
import uiPng from '../assets/ui.png';

const highlights = [
	{
		t: 'Cache Matrix',
		d: 'Every cached role and collection with sortable TYPE / NAME / VERSION / LAST ACCESS / DISK USAGE columns, live search, DENSITY and ALL / ROLES / COLLECTIONS filters, LATEST pills on newest versions, fresh-access pulses, keyboard shortcuts, and collapsed multi-version rows that unfold on click.',
	},
	{
		t: 'Tail-f log stream',
		d: 'A sliding ▲ LOG STREAM drawer behaves like tail -f — pinned to new lines, releasing when you scroll up, with colorized levels, a text filter, and one-click download to orbitron-logs.txt.',
	},
	{
		t: 'System telemetry',
		d: 'The ◄ SYS METRICS sidebar reports uplink status, cache activity, cache disk usage, mount free space, OS, architecture and last boot, plus a 14-day access sparkline. Auto-refreshing.',
	},
	{
		t: 'Live sync status',
		d: 'A header indicator tracks background mirror jobs — cyan when idle, spinning while syncing, red on failure — with a ⟳ SYNC button to force a full re-sync on demand.',
	},
	{
		t: 'Air-gap friendly',
		d: 'HTMX is embedded in memory — no external CDN calls. Cookie-based auth, or SSO via Keycloak. Type the mirror’s name for a surprise.',
	},
];
---

<section class="section dash" id="dashboard">
	<div class="wrap">
		<div class="section-head">
			<span class="eyebrow">The /ui dashboard</span>
			<h2>Operations on the bridge of a spaceship</h2>
			<p>
				Full-screen, zero-dependency monitoring built into the binary and styled like the Orbitron
				site itself — a soft galaxy backdrop with drifting orbital rings, from the login screen to
				the cache matrix.
			</p>
		</div>

		<div class="dash-grid">
<div class="browser">
			<div class="browser-bar">
				<span class="dots"><span></span><span></span><span></span></span>
				<span class="addr">orbitron // cache matrix</span>
				<span class="zoom-hint">↗ klik voor volledige grootte</span>
			</div>
			<a class="dash-img-open" href={uiPng.src} title="Open het dashboard-screenshot in volledige grootte">
				<Image
					src={uiPng}
					alt="Orbitron web dashboard — cache matrix"
					width={3024}
					height={1898}
					widths={[640, 1024, 1600, 3024]}
					sizes="(min-width: 900px) min(100%, 94rem), 100vw"
					loading="lazy"
				/>
			</a>
		</div>

		<div class="dash-lightbox" role="dialog" aria-modal="true" aria-label="Dashboard-screenshot, uitvergroot">
			<img data-full src={uiPng.src} alt="Orbitron dashboard screenshot, volledige grootte" />
		</div>

		<ul class="dash-list">
			{
				highlights.map((h) => (
					<li class="dash-item">
						<h3>{h.t}</h3>
						<p>{h.d}</p>
					</li>
				))
			}
		</ul>
		</div>
	</div>
</section>

<script>
	document.querySelectorAll('.dash-img-open').forEach((a) => {
		a.addEventListener('click', (e) => {
			e.preventDefault();
			const lb = document.querySelector('.dash-lightbox');
			if (!lb) {
				window.open(a.href, '_blank', 'noopener');
				return;
			}
			lb.classList.add('open');
		});
	});
	document.querySelectorAll('.dash-lightbox').forEach((lb) => {
		lb.addEventListener('click', () => lb.classList.remove('open'));
		lb.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') lb.classList.remove('open');
		});
	});
</script>

<style>
	.dash {
		background: linear-gradient(180deg, transparent, rgba(13, 14, 22, 0.5) 20%, rgba(13, 14, 22, 0.5) 80%, transparent);
	}

	.dash-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.7rem;
		align-items: start;
	}

	.browser {
		border: 1px solid var(--border);
		border-radius: var(--radius);
		overflow: hidden;
		background: var(--bg-deep);
		box-shadow: 0 40px 90px -40px rgba(0, 0, 0, 0.9), 0 0 0 1px rgba(0, 240, 255, 0.06);
	}

	.browser-bar {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		padding: 0.65rem 0.9rem;
		border-bottom: 1px solid var(--border);
		background: rgba(5, 5, 5, 0.6);
	}

	.dots {
		display: inline-flex;
		gap: 0.35rem;
	}
	.dots span {
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: #2a3038;
	}
	.dots span:nth-child(1) { background: var(--red); }
	.dots span:nth-child(2) { background: var(--yellow); }
	.dots span:nth-child(3) { background: var(--cyan); }

	.addr {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--text-dim);
		background: rgba(139, 148, 158, 0.08);
		border: 1px solid var(--border);
		border-radius: 6px;
		padding: 0.2rem 0.7rem;
		margin-inline: auto;
	}

	.zoom-hint {
		font-family: var(--font-mono);
		font-size: 0.62rem;
		color: rgba(0, 240, 255, 0.75);
		letter-spacing: 0.06em;
	}

	.dash-img-open {
		display: block;
		cursor: zoom-in;
		outline: none;
	}
	.dash-img-open:focus-visible img {
		box-shadow: 0 0 0 2px var(--cyan);
	}

	.browser img {
		width: 100%;
		height: auto;
	}

	.dash-lightbox {
		position: fixed;
		inset: 0;
		z-index: 200;
		display: none;
		align-items: center;
		justify-content: center;
		padding: 2.2rem;
		background: rgba(2, 4, 10, 0.92);
		cursor: zoom-out;
	}
	.dash-lightbox.open { display: flex; }
	.dash-lightbox img {
		max-width: 100%;
		max-height: 100%;
		width: auto;
		height: auto;
		border-radius: var(--radius);
		box-shadow: 0 30px 90px -20px rgba(0, 0, 0, 0.95), 0 0 0 1px rgba(0, 240, 255, 0.15);
	}

	.dash-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 0.9rem;
	}

	.dash-item {
		padding: 1.1rem 1.2rem;
		background: linear-gradient(180deg, var(--bg-card) 0%, var(--bg-panel) 100%);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		transition: border-color 0.2s ease, transform 0.2s ease;
	}

	.dash-item:hover {
		border-color: rgba(0, 240, 255, 0.35);
		transform: translateY(-2px);
	}

	.dash-item h3 {
		font-size: 0.95rem;
		color: var(--cyan);
		font-family: var(--font-mono);
		font-weight: 600;
		margin-bottom: 0.35rem;
		letter-spacing: 0.02em;
	}

	.dash-item p {
		font-size: 0.87rem;
		color: var(--text-dim);
	}
</style>